# Vite only exposes variables prefixed with VITE_ to client code.
# The anon key is safe to expose — it is designed for public/client use and
# is only ever as powerful as the RLS policies allow. NEVER put the Supabase
# service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# Web push (Announcement Module) — public half of the backend's VAPID key pair.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
