# Server
PORT=4000
NODE_ENV=development
# Comma-separated if you need more than one (e.g. apex domain + www, or a
# Vercel preview URL) — no spaces around the comma.
CORS_ORIGIN=http://localhost:5173
# Used to build redirect URLs for invite emails (must be allow-listed in
# Supabase Auth > URL Configuration > Redirect URLs).
FRONTEND_URL=http://localhost:5173

# Supabase — get these from Project Settings > API in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely.
# It must NEVER be sent to the frontend or committed to source control.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Logging
LOG_LEVEL=info

# Web push (Announcement Module) — generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@school.local
