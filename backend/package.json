{
  "name": "sms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Smart School Management System — API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
